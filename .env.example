# Anthropic Claude API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PropertyMonitor Credentials (for scraper)
PROPERTYMONITOR_EMAIL=your-email@example.com
PROPERTYMONITOR_PASSWORD=your-password-here

# ORVA API auth -- REQUIRED. Must be >= 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: JWT lifetime in hours (default 168 = 7 days)
# JWT_EXPIRY_HOURS=168

# Optional: comma-separated CORS origins (default localhost only).
# In production include your web app's public URL, e.g.
#   CORS_ORIGINS=https://yourdomain.com,http://YOUR_SERVER_IP:3000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: path to a JSON file with {username: {name, email, password_hash}}.
# Generate a password_hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'PASSWORD', bcrypt.gensalt()).decode())"
# USERS_FILE=/path/to/users.json

# Optional: override the Claude model used by the HLM chat service.
# Defaults to claude-sonnet-4-6. Set to a specific snapshot to pin the
# version, or switch to claude-haiku-4-5-20251001 for cheaper runs.
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: orva_api log level (DEBUG, INFO, WARNING, ERROR). Default INFO.
# LOG_LEVEL=INFO
