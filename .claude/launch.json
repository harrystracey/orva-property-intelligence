{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js (orva-web)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "orva-web"],
      "port": 3000
    },
    {
      "name": "FastAPI (orva_api)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "orva_api.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "Streamlit (app.py)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"],
      "port": 8501
    },
    {
      "name": "WhatsApp Bot 1 (wa-1)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "wa-1"],
      "port": 3001
    },
    {
      "name": "WhatsApp Bot 2 (wa-2)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "wa-2"],
      "port": 3002
    },
    {
      "name": "All (docker-compose)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up"],
      "port": 3000
    }
  ]
}
